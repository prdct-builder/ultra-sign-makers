{
  "name": "website-builder",
  "version": "1.0.0",
  "description": "Multi-site business website platform — Vue 3 + Vite + Tailwind CSS",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/site.mjs dev",
    "build": "node scripts/site.mjs build",
    "preview": "node scripts/site.mjs preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .vue,.js,.ts,.cjs,.mjs --fix --ignore-path .gitignore",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.55.0",
    "eslint-plugin-vue": "^9.19.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
  }
}
